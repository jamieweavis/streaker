{
  "name": "streaker",
  "productName": "Streaker",
  "private": true,
  "description": "Cross-platform GitHub contribution streak and statistic tracking menu bar application with reminder notification",
  "version": "2.6.2",
  "homepage": "https://github.com/jamieweavis/streaker#readme",
  "license": "MIT",
  "main": ".webpack/main/index.cjs",
  "author": "Jamie Weavis",
  "packageManager": "pnpm@10.18.3",
  "repository": "github:jamieweavis/streaker",
  "bugs": {
    "url": "https://github.com/jamieweavis/streaker/issues"
  },
  "keywords": [
    "contribution",
    "contribution-graph",
    "electron",
    "electron-app",
    "github",
    "macos",
    "menubar",
    "streak"
  ],
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "check": "biome check src",
    "check:write": "pnpm check -- --write"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "auto-launch": "5.0.6",
    "contribution": "8.0.0",
    "cron": "4.4.0",
    "electron-log": "5.4.4",
    "electron-squirrel-startup": "1.0.1",
    "electron-store": "11.0.2",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "update-electron-app": "3.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-webpack": "8.0.1",
    "@electron-forge/publisher-github": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/auto-launch": "5.0.5",
    "@vercel/webpack-asset-relocator-loader": "1.11.0",
    "css-loader": "7.1.5",
    "electron": "44.7.0",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "node-loader": "2.1.0",
    "postcss-loader": "8.2.1",
    "semantic-release": "25.0.9",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/changelog",
      "@semantic-release/commit-analyzer",
      "@semantic-release/npm",
      "@semantic-release/git",
      "@semantic-release/github",
      "@semantic-release/release-notes-generator"
    ]
  }
}
